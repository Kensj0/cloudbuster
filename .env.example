# cloudbuster private settings: TEMPLATE.
#
# Copy to $CLOUDBUSTER_CONFIG_DIR/.env (default /etc/cloudbuster/.env), owned by
# root with mode 600. Never commit the real file. Every value below is a
# placeholder; generate passwords with: openssl rand -hex 24

# ---- Locations ---------------------------------------------------------------
# Private configuration (this file, config.yaml). root:root 0700.
CLOUDBUSTER_CONFIG_DIR=/etc/cloudbuster
# All service data (photos, files, databases, sync state). root:root 0700.
CLOUDBUSTER_DATA_DIR=/srv/cloudbuster
# Where backups are written (see scripts/backup.sh). Should be another disk.
CLOUDBUSTER_BACKUP_DIR=/mnt/backup/cloudbuster
# Optional extra compose files, space separated, relative to the repo or absolute.
# Example for your own domain: compose/caddy.yml
CLOUDBUSTER_EXTRA_COMPOSE=

TZ=Etc/UTC

# ---- Immich ------------------------------------------------------------------
# Pin a release, and update the Immich image pins in docker-compose.yml together
# with it (see docs/operations.md). Tested: v3.3.1
IMMICH_VERSION=v3.3.1
IMMICH_PORT=2283
IMMICH_DB_PASSWORD=change-me-letters-and-digits-only

# ---- Nextcloud ---------------------------------------------------------------
# Tested: 35-apache
NEXTCLOUD_VERSION=35-apache
NEXTCLOUD_PORT=8080
NEXTCLOUD_DB_PASSWORD=change-me
NEXTCLOUD_REDIS_PASSWORD=change-me
# Only used on the very first start to create the admin account.
# Remove both lines from this file after the first start.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
# The host name you reach Nextcloud on, e.g. myserver.tailnet-name.ts.net
NEXTCLOUD_PUBLIC_HOST=
# "https" when Nextcloud is behind Tailscale Serve or Caddy.
NEXTCLOUD_OVERWRITE_PROTOCOL=https

# Only with compose/caddy.yml:
NEXTCLOUD_DOMAIN=
IMMICH_DOMAIN=

# ---- Sync service (only these two secrets reach the sync container) ----------
# API key of the Immich user that owns the shared album. Permissions: see docs/install.md
SYNC_IMMICH_API_KEY=
SYNC_NEXTCLOUD_USER=nextcloud-sync
# App password of SYNC_NEXTCLOUD_USER (Personal settings > Security > App passwords)
SYNC_NEXTCLOUD_APP_PASSWORD=

# ---- Isolated AI agent -------------------------------------------------------
# Linux user that runs the agent. No sudo, not in the docker group.
AGENT_USER=agent
# Folder the agent works in (inside the agent's home). Synced by nextcloudcmd.
AGENT_SYNC_DIR=/home/agent/agent-folder
# Nextcloud account used by the agent's sync client (sees only the shared folder).
AGENT_NEXTCLOUD_USER=ai-agent
# The shared folder's name as it appears in the agent account (usually /<folder name>).
AGENT_REMOTE_FOLDER=/shared-with-agent
# Your normal Linux login. Used by the isolation test to check the agent can't read your home.
OWNER_USER=
